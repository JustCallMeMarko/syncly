<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.TaskSched">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:id="@+id/heading"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_task"
            android:id="@+id/calendarLogo"
            app:tint="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/calendarLogo"
            android:text="Tasks &amp; Schedule"
            android:textSize="18dp"
            android:layout_marginLeft="8dp"
            android:textStyle="bold"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_setting"
            android:id="@+id/settingBtn"
            app:tint="@color/black"
            android:layout_alignParentEnd="true"
            />
    </RelativeLayout>
    <CalendarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/heading"
        android:id="@+id/calendar"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/calendar"
        android:layout_marginHorizontal="20dp"
        android:id="@+id/upcoming">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Upcoming"
            android:layout_centerVertical="true"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="6dp"
            android:textSize="16sp"
            android:text="Pomodoro"
            android:layout_alignParentEnd="true"
            android:id="@+id/pomodoroBtn"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/upcoming"
        android:layout_above="@id/addBtn"
        android:layout_marginHorizontal="20dp"
        android:id="@+id/recyclerView"/>
    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textSize="16sp"
        android:text="Add Task/Schedule"
        android:backgroundTint="@color/black"
        android:layout_marginHorizontal="20dp"
        app:cornerRadius="10dp"
        android:insetBottom="0dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/addBtn"
        android:layout_marginBottom="12dp"/>
</RelativeLayout>